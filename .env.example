# =============================================================================
# Pipeline RAG Python — 环境变量配置示例
# 复制为 .env 并填写真实值
# =============================================================================

# ── FastAPI ──────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080

# ── MySQL（业务数据库 + LangGraph Checkpointer）──────────────────────────────
# 注意：LangGraph checkpoint-mysql 要求 mysql:8.4，禁止 9.x
# 连接串由 MYSQL_HOST / MYSQL_PORT / MYSQL_DB / MYSQL_USER / MYSQL_PASSWORD 自动推导，
# 无需（也无法）通过 DATABASE_URL 覆盖。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=pipeline_rag
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# ── PostgreSQL + PGVector（向量检索）────────────────────────────────────────
# 连接串由 POSTGRES_HOST / POSTGRES_PORT / POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD 自动推导。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pipeline_rag_vector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_pg_password

# ── Elasticsearch（关键词检索，IK 分词）─────────────────────────────────────
ES_ENABLED=true
ES_HOST=localhost
ES_PORT=9200
ES_SCHEME=http
ES_USER=elastic
ES_PASSWORD=elastic
ES_INDEX_PREFIX=pipeline_rag
ES_KEYWORD_INDEX_NAME=pipeline_rag_document_keyword
ES_NAVIGATION_INDEX_NAME=pipeline_rag_document_navigation
ES_ROUTE_INDEX_NAME=pipeline_rag_knowledge_route
ES_ANALYZER=ik_max_word
ES_SEARCH_ANALYZER=ik_smart
ES_CONNECT_TIMEOUT_MS=3000
ES_SOCKET_TIMEOUT_MS=5000

# ── Redis（缓存 + 分布式锁 + Celery Broker）─────────────────────────────────
# 连接串由 REDIS_HOST / REDIS_PORT / REDIS_DB / REDIS_PASSWORD 自动推导。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Neo4j（文档结构图谱）────────────────────────────────────────────────────
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_SECONDS=5

# ── MinIO（对象存储）────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pipeline-rag-document
MINIO_SECURE=false
MINIO_OBJECT_PREFIX=rag/document
MINIO_PARSED_TEXT_PREFIX=rag/parsed-text

# ── LLM 服务（OpenAI 兼容接口）──────────────────────────────────────────────
# DeepSeek（OpenAI 兼容）；若用其他兼容服务可替换 base_url/api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_dashscope_api_key
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=5000
# Embedding 端点（DeepSeek 不支持 embedding，使用 SiliconFlow BGE-M3）
LLM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LLM_EMBEDDING_API_KEY=your_dashscope_api_key
LLM_EMBEDDING_PROVIDER=openai
LLM_EMBEDDING_MODEL=BAAI/bge-m3
LLM_EMBEDDING_DIMENSIONS=1024  # BGE-M3 实际维度

# ── Tavily 联网搜索 ──────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key

# ── Rerank 服务（SiliconFlow 兼容协议）───────────────────────────────────────
RERANK_ENABLED=true
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=your_siliconflow_api_key
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── JWT 认证 ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
JWT_ADMIN_USERNAME=admin
JWT_ADMIN_PASSWORD=admin123456

# ── Celery 异步任务 ──────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── RAG 检索参数（宽召回 + 窄精排）─────────────────────────────────────────────
# P0-2: Contextual Chunking（embedding 附加文档名+章节路径，提升召回；改后需重新向量化）
RAG_CONTEXTUAL_CHUNKING_ENABLED=true
# 单通道各召回 20 → RRF 融合候选 30 → Parent-Block 提升 → Rerank 过滤 → 最终 5 条进 Prompt
RAG_VECTOR_TOP_K=20
RAG_KEYWORD_TOP_K=20
RAG_CANDIDATE_TOP_K=30
RAG_FINAL_TOP_K=5
RAG_MIN_VECTOR_SIMILARITY=0.45
RAG_KEYWORD_SCORE_RATIO=0.35
RAG_RRF_K=60
RAG_PROMPT_BUDGET_TOTAL=5200
RAG_PROMPT_BUDGET_PER_SUBQUESTION=2200

# ── RAG 查询改写 ──────────────────────────────────────────────────────────────
RAG_REWRITE_ENABLED=true
RAG_REWRITE_HISTORY_TURNS=4
RAG_REWRITE_TEMPERATURE=0.1
RAG_REWRITE_TOP_P=0.3
RAG_REWRITE_THINKING=false

# ── RAG 质量评估 ──────────────────────────────────────────────────────────────
RAG_EVALUATION_ENABLED=true
RAG_EVALUATION_MODEL=
RAG_EVALUATION_SAMPLE_RATE=0.1  # LLM-as-Judge 采样率：0.1=10%（全量 1.0 会让每轮成本翻倍）

# ── RAG Supervisor 任务分解 ───────────────────────────────────────────────────
RAG_SUPERVISOR_ENABLED=true
# P0-1c: 规则预筛——简单问题不触发 LLM 分解（复合/分析类/长问题才分解）
RAG_SUPERVISOR_RULE_PREFILTER=true
RAG_SUPERVISOR_TEMPERATURE=0.1
RAG_SUPERVISOR_MAX_REVIEW_RETRIES=2

# ── 安全检测层 ─────────────────────────────────────────────────────────────────
SAFETY_MODE=fail_close
SAFETY_INPUT_PII_ENABLED=true
SAFETY_INPUT_INJECTION_ENABLED=true
# P0-1a: LLM 深度意图护栏（默认关，规则层已含注入检测+PII；仅规则不决时再开启）
SAFETY_INPUT_LLM_GUARDRAIL_ENABLED=false
SAFETY_INPUT_INJECTION_THRESHOLD=7.0
SAFETY_OUTPUT_PII_ENABLED=true
SAFETY_OUTPUT_SENSITIVE_ENABLED=true
SAFETY_TOOL_APPROVAL_ENABLED=true

# ── 熔断器 ─────────────────────────────────────────────────────────────────────
CB_ENABLED=true
CB_DEFAULT_TIMEOUT=30
CB_LLM_FAILURE_THRESHOLD=5
CB_LLM_RECOVERY_TIMEOUT=60

# ── Agent 安全限制 ───────────────────────────────────────────────────────────
AGENT_MAX_MODEL_CALLS_PER_RUN=8
AGENT_MAX_TOOL_CALLS_PER_RUN=6
AGENT_MAX_MODEL_CALLS_PER_SESSION=40
AGENT_MAX_TOOL_CALLS_PER_SESSION=30
AGENT_SYSTEM_PROMPT=

# ── 记忆策略 ─────────────────────────────────────────────────────────────────
# none | sliding_window | summary_compression
MEMORY_ENABLED=true
MEMORY_STRATEGY=summary_compression
MEMORY_WINDOW_SIZE=4
MEMORY_MAX_SUMMARY_CHARS=1400
MEMORY_MAX_WINDOW_CHARS=2200
MEMORY_SUMMARY_BATCH_SIZE=6
MEMORY_MAX_SECTION_ITEMS=6
MEMORY_MAX_ITEM_LENGTH=80

# ── OpenTelemetry 可观测性 ───────────────────────────────────────────────────

# ── 推荐追问 ─────────────────────────────────────────────────────────────────
RECOMMEND_ENABLED=true
RECOMMEND_TIMEOUT_MS=3000

# ── 对话响应缓存（第二轮评审：缓存无历史上下文的确定性问答，命中省全链路 LLM）─
CHAT_CACHE_ENABLED=false
CHAT_CACHE_TTL_HOURS=24

# ── 飞书机器人渠道（P3-4：长连接事件订阅 + 卡片流式回复）────────────────────
# 需在飞书开放平台创建自建应用并开通机器人能力；长连接模式无需公网回调地址
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_STREAM_UPDATE_INTERVAL_MS=500
FEISHU_BOT_OPEN_ID=
FEISHU_WEB_BASE_URL=http://localhost:5173

# ── S3 数据源连接器（P3-3：扫描 S3 兼容存储导入文档流水线）────────────────
CONNECTOR_S3_ENABLED=false
CONNECTOR_S3_ENDPOINT=https://s3.amazonaws.com
CONNECTOR_S3_ACCESS_KEY=
CONNECTOR_S3_SECRET_KEY=
CONNECTOR_S3_BUCKET=
CONNECTOR_S3_PREFIX=
CONNECTOR_S3_FILE_TYPES=.pdf,.docx,.doc,.txt,.md,.pptx,.xlsx
CONNECTOR_S3_BATCH_SIZE=10

# ── 网页爬虫连接器（P3-3：抓取公开站点内容，sitemap/种子递归发现）─────────
CONNECTOR_WEB_ENABLED=false
CONNECTOR_WEB_SITEMAP_URL=
CONNECTOR_WEB_SEED_URLS=
CONNECTOR_WEB_MAX_PAGES=50
CONNECTOR_WEB_MAX_DEPTH=2
CONNECTOR_WEB_CONCURRENCY=4
CONNECTOR_WEB_DELAY_SECONDS=0.5
CONNECTOR_WEB_RESPECT_ROBOTS=true

# ── MinerU 文档解析增强通道（P2-4：复杂版式/扫描件/表格，失败自动降级 unstructured）─────
MINERU_ENABLED=false
MINERU_BASE_URL=https://mineru.net
MINERU_API_KEY=
# agent=免token（≤10MB/20页）| extract=需token（≤200MB/200页）
MINERU_MODE=agent

# ── 文档结构解析 ─────────────────────────────────────────────────────────────
STRUCTURE_MAX_PLAIN_HEADING_CHARS=32
STRUCTURE_LLM_DISAMBIGUATION_ENABLED=true
STRUCTURE_AMBIGUITY_CONFIDENCE_FLOOR=0.45
STRUCTURE_AMBIGUITY_CONFIDENCE_CEIL=0.80
STRUCTURE_MAX_AMBIGUOUS_SIGNALS_PER_CALL=8
STRUCTURE_CONTEXT_WINDOW_LINES=2

# ── 文档分段 ─────────────────────────────────────────────────────────────────
CHUNK_RECURSIVE_MAX_CHARS=800
CHUNK_RECURSIVE_OVERLAP_CHARS=120
CHUNK_SEMANTIC_MAX_CHARS=700
CHUNK_SEMANTIC_MIN_CHARS=240
CHUNK_SEMANTIC_SIMILARITY_THRESHOLD=0.18
CHUNK_LLM_ENABLED=false
CHUNK_LLM_MAX_CHARS=3500
CHUNK_RECOMMEND_LLM_WHEN_LOW_QUALITY=true

# ── Redis 滑动窗口限流 ───────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_CALLS=10
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_CALLS=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_MANAGE_CALLS=60
RATE_LIMIT_MANAGE_WINDOW_SECONDS=60
# 可信反向代理层数：直连部署保持 0（不信任 X-Forwarded-For，防伪造绕过限流）；
# 有 N 层可信反代时设为 N（如 Nginx 一层则设为 1）。
RATE_LIMIT_TRUST_PROXY_COUNT=0

# ── 线上演示只读模式 ─────────────────────────────────────────────────────────
PREVIEW_ENABLED=false
PREVIEW_MESSAGE=当前环境为只读展示模式，仅开放浏览与检索能力
