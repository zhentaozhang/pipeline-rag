# =============================================================================
# Pipeline RAG Python — 环境变量配置示例
# 复制为 .env 并填写真实值
# =============================================================================

# ── FastAPI ──────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080

# ── MySQL（业务数据库 + LangGraph Checkpointer）──────────────────────────────
# 注意：LangGraph checkpoint-mysql 要求 mysql:8.4，禁止 9.x
# 连接串由 MYSQL_HOST / MYSQL_PORT / MYSQL_DB / MYSQL_USER / MYSQL_PASSWORD 自动推导，
# 无需（也无法）通过 DATABASE_URL 覆盖。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=pipeline_rag
MYSQL_USER=pipeline_rag
MYSQL_PASSWORD=your_mysql_password

# ── PostgreSQL + PGVector（向量检索）────────────────────────────────────────
# 连接串由 POSTGRES_HOST / POSTGRES_PORT / POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD 自动推导。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pipeline_rag_vector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_pg_password

# ── Elasticsearch（关键词检索，IK 分词）─────────────────────────────────────
ES_ENABLED=true
ES_HOST=localhost
ES_PORT=9200
ES_SCHEME=http
ES_USER=elastic
ES_PASSWORD=elastic
ES_INDEX_PREFIX=pipeline_rag
ES_KEYWORD_INDEX_NAME=pipeline_rag_document_keyword
ES_NAVIGATION_INDEX_NAME=pipeline_rag_document_navigation
ES_ROUTE_INDEX_NAME=pipeline_rag_knowledge_route
ES_ANALYZER=ik_max_word
ES_SEARCH_ANALYZER=ik_smart
ES_CONNECT_TIMEOUT_MS=3000
ES_SOCKET_TIMEOUT_MS=5000

# ── Redis（缓存 + 分布式锁 + Celery Broker）─────────────────────────────────
# 连接串由 REDIS_HOST / REDIS_PORT / REDIS_DB / REDIS_PASSWORD 自动推导。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Neo4j（文档结构图谱）────────────────────────────────────────────────────
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_SECONDS=5

# ── MinIO（对象存储）────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pipeline-rag-document
MINIO_SECURE=false
MINIO_OBJECT_PREFIX=rag/document
MINIO_PARSED_TEXT_PREFIX=rag/parsed-text

# ── LLM 服务（OpenAI 兼容接口）──────────────────────────────────────────────
# DeepSeek（OpenAI 兼容）；若用其他兼容服务可替换 base_url/api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_dashscope_api_key
LLM_MODEL=deepseek-v4-flash
LLM_CONTEXT_WINDOW_LIMIT=500000
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=5000
# Embedding 端点（DeepSeek 不支持 embedding，使用 SiliconFlow BGE-M3）
LLM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LLM_EMBEDDING_API_KEY=your_dashscope_api_key
LLM_EMBEDDING_PROVIDER=openai
LLM_EMBEDDING_MODEL=BAAI/bge-m3
LLM_EMBEDDING_DIMENSIONS=1024  # BGE-M3 实际维度

# ── Tavily 联网搜索 ──────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key

# ── Rerank 服务（SiliconFlow 兼容协议）───────────────────────────────────────
RERANK_ENABLED=true
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=your_siliconflow_api_key
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 重排后保留条数（P1：由 3 放宽到 10，避免重排阶段过早砍掉召回）
RERANK_TOP_N=10

# ── JWT 认证 ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
JWT_ADMIN_USERNAME=admin
JWT_ADMIN_PASSWORD=admin123456

# ── Celery 异步任务 ──────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── RAG 检索参数（宽召回 + 窄精排）─────────────────────────────────────────────
# P0-2: Contextual Chunking（embedding 附加文档名+章节路径，提升召回；改后需重新向量化）
RAG_CONTEXTUAL_CHUNKING_ENABLED=true
# P0-1 真 Contextual Retrieval（LLM 生成 chunk 上下文，Anthropic 方法）：
# 默认关；开启后需重新向量化才生效；任一环节失败自动回退，不阻断入库。
RAG_CONTEXTUAL_LLM_ENABLED=false
RAG_CONTEXTUAL_LLM_MODEL=
RAG_CONTEXTUAL_LLM_MAX_DOC_CHARS=24000
RAG_CONTEXTUAL_MAX_TOKENS=120
RAG_CONTEXTUAL_LLM_CONCURRENCY=4
# 单通道各召回 50 → RRF 融合候选 50 → Parent-Block 提升 → Rerank 过滤 → 最终 8 条进 Prompt
# P1：加深各阶段候选池，避免 RRF/重排信号不足导致的召回坍塌
RAG_VECTOR_TOP_K=50
RAG_KEYWORD_TOP_K=50
# 关键词通道查询宽严度（ES multi_match.minimum_should_match）。默认值与历史行为一致。
# 调松（如 2）会扩大候选池，需用 hard85 配对 bootstrap 确认收益后再改默认。
RAG_KEYWORD_MINIMUM_SHOULD_MATCH=1<50%
# 是否把 jieba 词项作为 should 子句注入（默认关；打开等于同时放宽+加权）
RAG_KEYWORD_TERM_EXPANSION_ENABLED=false
RAG_CANDIDATE_TOP_K=50
RAG_FINAL_TOP_K=8
RAG_MIN_VECTOR_SIMILARITY=0.45
RAG_VECTOR_RELATIVE_RATIO=0.35
RAG_KEYWORD_SCORE_RATIO=0.35
# RRF 融合：企业规章小样本场景下推荐 k=30，更能凸显单通道 Top-1 优势
RAG_RRF_K=30
RAG_RRF_VECTOR_WEIGHT=1.0
RAG_RRF_KEYWORD_WEIGHT=1.0
# P2-6 查询类型自适应融合（默认关）：精确标识型查询偏关键词、概念型偏向量
RAG_QUERY_ADAPTIVE_WEIGHT_ENABLED=false
RAG_ADAPTIVE_KEYWORD_BIAS=1.6
RAG_ADAPTIVE_VECTOR_BIAS=1.6
# P2 多跳拆分：复合/多条件单句问题拆为多子查询
# A/B 实测（25 题）：拆分 R@5 0.7133 < 不拆分 0.7267，故默认关（opt-in）
RAG_MULTI_HOP_SPLIT_ENABLED=false
# P3-8 迭代式多跳（默认关，需 LLM）：检索→生成下一跳查询→再检索，累积去重
RAG_ITERATIVE_MULTI_HOP_ENABLED=false
RAG_ITERATIVE_MULTI_HOP_MAX_HOPS=2
# P1-3 元数据预过滤（默认关）：把问题里的"章节提示"（第8条/附录A）经存在性校验后
# 下推为 section_path 前缀过滤；校验失败即跳过，绝不因过滤制造零召回。
RAG_METADATA_PREFILTER_ENABLED=false
RAG_METADATA_PREFILTER_CACHE_TTL_SECONDS=300
# P2-7 LongContextReorder（默认关）：证据重排为"首尾最相关、中部最不相关"，缓解 lost-in-the-middle
RAG_LONG_CONTEXT_REORDER_ENABLED=false
RAG_PROMPT_BUDGET_TOTAL=20000
RAG_PROMPT_BUDGET_PER_SUBQUESTION=8000
RAG_PARENT_EVIDENCE_MAX_CHARS=4000
# 单条引用渲染上限（此前硬编码 1100，使父块预算失效）
RAG_REFERENCE_SNIPPET_MAX_CHARS=2000
# 评测裁判可见上下文上限（与生成侧预算对齐，避免裁判低估）
RAG_EVAL_CONTEXT_MAX_CHARS=20000
# R1 条件重排：首候选相似度 >= 该值时跳过重排（0=关闭）
RAG_RERANK_SKIP_MIN_SIMILARITY=0.0
# R2 rank-1 保护：重排不得把第一阶段首候选降级（分差在 margin 内时恢复榜首）
RAG_RERANK_RANK1_GUARD_ENABLED=false
RAG_RERANK_RANK1_GUARD_MARGIN=0.15

# ── RAG 查询改写 ──────────────────────────────────────────────────────────────
RAG_REWRITE_ENABLED=true
RAG_REWRITE_HISTORY_TURNS=4
RAG_REWRITE_TEMPERATURE=0.1
RAG_REWRITE_TOP_P=0.3
RAG_REWRITE_THINKING=false

# ── RAG 质量评估 ──────────────────────────────────────────────────────────────
RAG_EVALUATION_ENABLED=true
RAG_EVALUATION_MODEL=
RAG_EVALUATION_SAMPLE_RATE=0.1  # LLM-as-Judge 采样率：0.1=10%（全量 1.0 会让每轮成本翻倍）

# ── RAG Supervisor 任务分解 ───────────────────────────────────────────────────
RAG_SUPERVISOR_ENABLED=true
# P0-1c: 规则预筛——简单问题不触发 LLM 分解（复合/分析类/长问题才分解）
RAG_SUPERVISOR_RULE_PREFILTER=true
RAG_SUPERVISOR_TEMPERATURE=0.1
RAG_SUPERVISOR_MAX_REVIEW_RETRIES=2

# ── 安全检测层 ─────────────────────────────────────────────────────────────────
SAFETY_MODE=fail_close
SAFETY_INPUT_PII_ENABLED=true
SAFETY_INPUT_INJECTION_ENABLED=true
# P0-1a: LLM 深度意图护栏（默认关，规则层已含注入检测+PII；仅规则不决时再开启）
SAFETY_INPUT_LLM_GUARDRAIL_ENABLED=false
# JEV System 1 决策护栏（单 pass 毫秒级判别，支持常态化全量开启深度安全审计）
SAFETY_JEV_GUARDRAIL_ENABLED=true
SAFETY_JEV_SAFE_THRESHOLD=0.50
SAFETY_INPUT_INJECTION_THRESHOLD=7.0
SAFETY_OUTPUT_PII_ENABLED=true
SAFETY_OUTPUT_SENSITIVE_ENABLED=true
SAFETY_TOOL_APPROVAL_ENABLED=true

# ── JEV System 1 本地判断服务（Qwen2.5 单 Pass 毫秒级决策层）────────────────────
JEV_BASE_URL=http://localhost:8085
JEV_PORT=8085
JEV_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# JEV 推理设备：cpu / cuda / mps（Apple Silicon 可用 mps 显著加速）；留空自动探测
JEV_DEVICE=cpu
# 单次前向容纳的问题数；越大前向次数越少、内存/显存峰值越高
JEV_BATCH_CHUNK=8
JEV_GUARDRAIL_ENABLED=true
JEV_INTENT_DETECTION_ENABLED=true
JEV_NAVIGATION_INTENT_ENABLED=true
JEV_CITATION_VERIFY_ENABLED=true
JEV_FAITHFULNESS_EVAL_ENABLED=true
JEV_ANSWER_RELEVANCY_ENABLED=true
JEV_ANSWER_CORRECTNESS_ENABLED=true
JEV_CONTEXT_PRECISION_ENABLED=true
JEV_CONTEXT_RECALL_ENABLED=true
# 结构歧义：A/B 实测 JEV 精度低于 LLM，默认关闭（off=走 LLM）
JEV_STRUCTURE_AMBIGUITY_ENABLED=false
JEV_EVIDENCE_SUFFICIENCY_ENABLED=true
JEV_QUALITY_EVAL_ENABLED=true
JEV_INJECTION_SEMANTIC_ENABLED=true
JEV_OUTPUT_SEMANTIC_ENABLED=true
JEV_TOOL_RISK_SEMANTIC_ENABLED=true
JEV_SAFE_THRESHOLD=0.50
JEV_CITATION_CONFIDENCE_THRESHOLD=0.60
# 置信度灰区（落入灰区则升级到 LLM/规则通道，避免 JEV 硬阈值误判）
JEV_GUARDRAIL_REVIEW_LOW=0.35
JEV_GUARDRAIL_REVIEW_HIGH=0.65
JEV_CITATION_REVIEW_LOW=0.45
JEV_TIMEOUT_SECONDS=2.0
# JEV 镜像构建期 pip 源与代理（容器网络受限时配置；留空 PIP_EXTRA_INDEX_URL 只走主源）
JEV_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
JEV_PIP_EXTRA_INDEX_URL=
JEV_HTTP_PROXY=

# ── 熔断器 ─────────────────────────────────────────────────────────────────────
CB_ENABLED=true
CB_DEFAULT_TIMEOUT=30
CB_LLM_FAILURE_THRESHOLD=5
CB_LLM_RECOVERY_TIMEOUT=60

# ── Agent 安全限制 ───────────────────────────────────────────────────────────
AGENT_MAX_MODEL_CALLS_PER_RUN=8
AGENT_MAX_TOOL_CALLS_PER_RUN=6
AGENT_MAX_MODEL_CALLS_PER_SESSION=40
AGENT_MAX_TOOL_CALLS_PER_SESSION=30
AGENT_SYSTEM_PROMPT=

# ── 记忆策略 ─────────────────────────────────────────────────────────────────
# none | sliding_window | summary_compression
MEMORY_ENABLED=true
MEMORY_STRATEGY=summary_compression
MEMORY_WINDOW_SIZE=4
MEMORY_MAX_SUMMARY_CHARS=1400
MEMORY_MAX_WINDOW_CHARS=2200
MEMORY_SUMMARY_BATCH_SIZE=6
MEMORY_MAX_SECTION_ITEMS=6
MEMORY_MAX_ITEM_LENGTH=80

# ── OpenTelemetry 可观测性 ───────────────────────────────────────────────────

# ── 推荐追问（默认关，延迟敏感场景可省约 2s，按需开启）────────────────────────
RECOMMEND_ENABLED=false
RECOMMEND_TIMEOUT_MS=3000

# ── 对话响应缓存（第二轮评审：缓存无历史上下文的确定性问答，命中省全链路 LLM）─
CHAT_CACHE_ENABLED=false
CHAT_CACHE_TTL_HOURS=24

# ── 飞书机器人渠道（P3-4：长连接事件订阅 + 卡片流式回复）────────────────────
# 需在飞书开放平台创建自建应用并开通机器人能力；长连接模式无需公网回调地址
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_STREAM_UPDATE_INTERVAL_MS=500
FEISHU_BOT_OPEN_ID=
FEISHU_WEB_BASE_URL=http://localhost:5173

# ── S3 数据源连接器（P3-3：扫描 S3 兼容存储导入文档流水线）────────────────
CONNECTOR_S3_ENABLED=false
CONNECTOR_S3_ENDPOINT=https://s3.amazonaws.com
CONNECTOR_S3_ACCESS_KEY=
CONNECTOR_S3_SECRET_KEY=
CONNECTOR_S3_BUCKET=
CONNECTOR_S3_PREFIX=
CONNECTOR_S3_FILE_TYPES=.pdf,.docx,.doc,.txt,.md,.pptx,.xlsx
CONNECTOR_S3_BATCH_SIZE=10

# ── 网页爬虫连接器（P3-3：抓取公开站点内容，sitemap/种子递归发现）─────────
CONNECTOR_WEB_ENABLED=false
CONNECTOR_WEB_SITEMAP_URL=
CONNECTOR_WEB_SEED_URLS=
CONNECTOR_WEB_MAX_PAGES=50
CONNECTOR_WEB_MAX_DEPTH=2
CONNECTOR_WEB_CONCURRENCY=4
CONNECTOR_WEB_DELAY_SECONDS=0.5
CONNECTOR_WEB_RESPECT_ROBOTS=true

# ── MinerU 文档解析增强通道（P2-4：复杂版式/扫描件/表格，失败自动降级 unstructured）─────
MINERU_ENABLED=false
MINERU_BASE_URL=https://mineru.net
MINERU_API_KEY=
# agent=免token（≤10MB/20页）| extract=需token（≤200MB/200页）
MINERU_MODE=agent

# ── 文档结构解析 ─────────────────────────────────────────────────────────────
STRUCTURE_MAX_PLAIN_HEADING_CHARS=32
STRUCTURE_LLM_DISAMBIGUATION_ENABLED=true
STRUCTURE_AMBIGUITY_CONFIDENCE_FLOOR=0.45
STRUCTURE_AMBIGUITY_CONFIDENCE_CEIL=0.80
STRUCTURE_MAX_AMBIGUOUS_SIGNALS_PER_CALL=8
STRUCTURE_CONTEXT_WINDOW_LINES=2

# ── 文档分段 ─────────────────────────────────────────────────────────────────
CHUNK_RECURSIVE_MAX_CHARS=800
CHUNK_RECURSIVE_OVERLAP_CHARS=120
CHUNK_SEMANTIC_MAX_CHARS=700
CHUNK_SEMANTIC_MIN_CHARS=240
CHUNK_SEMANTIC_SIMILARITY_THRESHOLD=0.18
CHUNK_LLM_ENABLED=false
CHUNK_LLM_MAX_CHARS=3500
CHUNK_RECOMMEND_LLM_WHEN_LOW_QUALITY=true
# P0-2 粒度校准：合并相邻小结构节点到目标 token 窗口（默认关，需重索引才生效）
CHUNK_MERGE_SMALL_SECTIONS_ENABLED=false
CHUNK_MERGE_TARGET_TOKENS=320
CHUNK_MERGE_MAX_TOKENS=512
# P1-5 稳定 chunk ID（默认关，需重索引才生效）：内容派生 ID，便于块级评估/版本 diff
CHUNK_STABLE_CHUNK_ID_ENABLED=false

# ── Redis 滑动窗口限流 ───────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_CALLS=10
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_CALLS=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_MANAGE_CALLS=60
RATE_LIMIT_MANAGE_WINDOW_SECONDS=60
# 可信反向代理层数：直连部署保持 0（不信任 X-Forwarded-For，防伪造绕过限流）；
# 有 N 层可信反代时设为 N（如 Nginx 一层则设为 1）。
RATE_LIMIT_TRUST_PROXY_COUNT=0

# ── 线上演示只读模式 ─────────────────────────────────────────────────────────
PREVIEW_ENABLED=false
PREVIEW_MESSAGE=当前环境为只读展示模式，仅开放浏览与检索能力

# ── 查询自适应 Top-k 截断（P2：RRF 前按得分分布动态截断，默认关）─────────
RAG_ADAPTIVE_K_ENABLED=false
RAG_ADAPTIVE_K_MIN_K=3
RAG_ADAPTIVE_K_MAX_K=20
RAG_ADAPTIVE_K_RATIO_THRESHOLD=0.4

# ── 用户事实记忆（P3 · Mem0 式：跨轮抽取用户事实/偏好，检索注入个性化）─────
RAG_USER_MEMORY_ENABLED=false
RAG_USER_MEMORY_EXTRACT_SAMPLE_RATE=1.0
RAG_USER_MEMORY_RETRIEVAL_TOP_K=3
RAG_USER_MEMORY_UPDATE_THRESHOLD=0.92
RAG_USER_MEMORY_MAX_FACTS=200
RAG_USER_MEMORY_RETENTION_DAYS=180

# ── Prompt Caching（P0）：缓存命中 input token 单价折扣系数（DeepSeek 命中约 1/10）
LLM_CACHE_HIT_PRICE_FACTOR=0.1

# ── PostgreSQL（第三轮 #1：HNSW 向量索引，防全表扫描）───────────────
PG_HNSW_INDEX_ENABLED=true

# ── MySQL（第三轮 #6：慢查询告警阈值 ms）────────────────────────────
MYSQL_SLOW_QUERY_MS=500

# ── Reranker 精排 ─────────────────────────────────────────────────────────
# 实测（85 题真实语料）：bge-reranker 分数两极化——top 0.85~0.98，其余绝大多数 ≈0.000~0.003。
# 旧值 0.35 会把 50 个候选砍到只剩 1~5 条（< final_top_k=8），导致召回坍塌（R@10 0.837→0.733）。
# 置 0 = 只重排不丢弃，截断交给 final_top_k。
RAG_RERANK_MIN_SCORE=0
# 相对阈值：保留 rerank_score >= top_score × ratio 的候选（0 = 不启用相对阈值）
RAG_RERANK_RELATIVE_RATIO=0
# D3 不变量（默认开）：阈值把证据集砍到 final_top_k 以下时自动跳过并告警，防止召回坍塌
RAG_RERANK_FILTER_STARVATION_GUARD_ENABLED=true

# ── Langfuse 可观测平台（LLM/RAG trace + 评估；默认关）────────────
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_URL=
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_FLUSH_AT=15
LANGFUSE_FLUSH_INTERVAL=0.5
LANGFUSE_RELEASE=
LANGFUSE_MAX_IO_CHARS=4000

# ── OpenTelemetry（OTLP HTTP 导出；Langfuse 不支持 gRPC）────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=pipeline-rag
OTEL_SAMPLE_RATE=1.0

# ── 可观测性自托管部署（docker-compose.observability.yml）─────────────────
# 启动：docker compose -f docker-compose.yml -f docker-compose.observability.yml \
#         --profile observability up -d
# 以下变量同时供：① compose 插值（顶层 langfuse-web/worker）；② app/celery 的
# env_file 读取。生产必须替换所有 CHANGEME 值。
#
# Langfuse API key（与 LANGFUSE_PUBLIC_KEY/SECRET_KEY 同值，自动开通项目）
#   LANGFUSE_PUBLIC_KEY=pk-lf-pipeline-rag
#   LANGFUSE_SECRET_KEY=sk-lf-pipeline-rag
#
# 必填密钥（生成：openssl rand -hex 32；LANGFUSE_SALT 可用 openssl rand -base64 32）
LANGFUSE_NEXTAUTH_SECRET=CHANGEME
LANGFUSE_SALT=CHANGEME
LANGFUSE_ENCRYPTION_KEY=CHANGEME

# 对外访问地址（浏览器）：UI 深链与 NEXTAUTH_URL
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_WEB_PORT=3000

# 自托管栈内部凭据（生产必须替换）
LANGFUSE_PG_PASSWORD=CHANGEME
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGEME
LANGFUSE_REDIS_PASSWORD=CHANGEME
LANGFUSE_MINIO_USER=langfuseminio
LANGFUSE_MINIO_PASSWORD=CHANGEME

# 初始管理员（仅首次开通生效）
LANGFUSE_INIT_USER_EMAIL=admin@pipeline-rag.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME

# ── 前端（独立部署，docker-compose.frontend.yml）─────────────────────────────
# 前端容器宿主端口（容器内 nginx 固定监听 80）
FRONTEND_PORT=80
# 前端 nginx 反代的后端地址（默认指向宿主机上已发布的后端端口）
# 前后端不在同一宿主机时，改为后端实际地址，例如 http://10.0.0.12:8080
BACKEND_URL=http://host.docker.internal:8080
# 构建期注入的前端 API 绝对地址；留空 = 同源相对路径（由 nginx 反代）
VITE_API_BASE_URL=

# ── 镜像构建源（可选：国内网络加速）──────────────────────────────────────────
# PyPI 索引（默认官方 https://pypi.org/simple）
UV_DEFAULT_INDEX=https://pypi.org/simple
# Debian apt 镜像（留空 = 官方 deb.debian.org；国内可填 mirrors.tuna.tsinghua.edu.cn）
APT_MIRROR=
# ES IK 中文分词插件（Docker 镜像构建期预烘焙；避免运行时外网拉取与单点故障）
# 插件地址（默认国内 CDN）；若构建期需经宿主代理，填 http://host.docker.internal:7897
ES_IK_PLUGIN_URL=https://get.infini.cloud/elasticsearch/analysis-ik/8.13.4
ES_HTTP_PROXY=
